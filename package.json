{
  "name": "obsidian-private-plugin-hub",
  "version": "1.1.1",
  "description": "Private Plugin Hub for downloading and updating custom Obsidian plugins.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "copy:vault": "mkdir -p /Users/s-ikari/work/playground/test-vault/.obsidian/plugins/obsidian-private-plugin-hub && cp main.js manifest.json styles.css /Users/s-ikari/work/playground/test-vault/.obsidian/plugins/obsidian-private-plugin-hub/",
    "build:vault": "npm run build && npm run copy:vault"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "custom-plugins",
    "plugin-market"
  ],
  "author": "s-ikari",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
